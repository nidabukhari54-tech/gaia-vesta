# --- Supabase (required for sign-in, saving charts, sharing, AI readings) ---
# Create a project at https://supabase.com, then run the SQL in supabase/migrations/
# in the Supabase SQL editor (or: supabase db push).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Optional: AI readings (Edge Function: interpret) ---
# supabase secrets set OPENAI_API_KEY=sk-...
# (also set SUPABASE_URL and SUPABASE_ANON_KEY as function secrets)

# --- Optional: Stripe payments (Edge Functions: create-checkout, stripe-webhook) ---
# supabase secrets set STRIPE_SECRET_KEY=sk_... STRIPE_PRICE_ID=price_... STRIPE_WEBHOOK_SECRET=whsec_... SUPABASE_SERVICE_ROLE_KEY=... SITE_URL=https://your-domain.com
